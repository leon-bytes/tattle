# Copy to .env and fill in. Never commit .env.

# backend (runs in the VM)
# Optional: delete this line to run without a database. Only sessions of phones marked "persist" are stored.
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>
# optional: other data files (relative paths count from the repo root). These are the defaults:
# KB_PATH=data/kb.json
# KB_OVERRIDES_PATH=data/kb_overrides.json
# AI_CACHE_SEED_PATH=data/ai_cache_seed.json
# LABELS_DIR=data/labels

# AI (optional): Ollama on the AMD server, reached through an SSH tunnel from the machine the backend runs on:
#   ssh -N -L 8081:127.0.0.1:11434 -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes amd
# Ollama needs no key; AI_TOKEN is a placeholder that is sent and ignored.
AI_BASE_URL=http://127.0.0.1:8081/v1
AI_TOKEN=unused
AI_MODEL=<model-name>

# sensor (runs on the box laptop itself; the backend is in the VM)
# On the box: http://<vm-ip>:8000 (the VM's 192.168.122.x address). In dev, everything is on one machine:
BACKEND_URL=http://127.0.0.1:8000
UPSTREAM_DNS=9.9.9.9
SENSOR_LISTEN=0.0.0.0:5300
SENSOR_MAX_TTL=10
# optional: where the sensor finds DHCP hostnames. Only read when it is started with --names (our own phones).
# LEASES_FILE=/var/lib/NetworkManager/dnsmasq-tattle0.leases
