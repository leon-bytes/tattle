# Copy to .env and fill in. Never commit .env.

# backend
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>
BACKEND_PORT=8000

# AI (OpenAI-compatible server on the AMD notebook)
AI_BASE_URL=https://<hub-address>/user/<hub-username>/proxy/<port>/v1
AI_TOKEN=<jupyterhub-api-token>
AI_MODEL=<model-name>

# sensor (runs on the box)
BACKEND_URL=http://127.0.0.1:8000
UPSTREAM_DNS=9.9.9.9
